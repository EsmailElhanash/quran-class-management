<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_margin="4dp"
    android:background="@drawable/bg1"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <ImageButton
        android:layout_margin="10dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@android:color/holo_red_light"
        android:background="@drawable/bg1"
        android:id="@+id/delete_hw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:contentDescription="@string/delete" />

    <EditText
        android:padding="8dp"
        android:background="@drawable/bg1_light"
        android:id="@+id/hw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:autofillHints="حفظ,مراجعة,ورد"
        android:ems="10"
        android:hint="@string/hw_title"
        android:inputType="textPersonName"
        android:textAlignment="viewStart"
        tools:ignore="LabelFor" />

    <TextView
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:textColor="@android:color/holo_blue_dark"
        android:text="@string/hw_start" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/sura_start_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:entries="@array/sura_names"
            android:spinnerMode="dialog"
            />

        <Spinner
            android:id="@+id/ayah_start_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1" />


    </LinearLayout>

    <TextView
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:textColor="@android:color/holo_blue_dark"
        android:text="@string/hw_end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:orientation="horizontal">

        <Spinner
            android:layout_weight="1"
            android:id="@+id/sura_end_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:entries="@array/sura_names"
            android:spinnerMode="dialog" />

        <Spinner
            android:layout_weight="1"
            android:id="@+id/ayah_end_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp" />

    </LinearLayout>

    <LinearLayout
        android:background="@drawable/bg1"
        android:id="@+id/hw_date_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <LinearLayout
        android:background="@drawable/bg1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:visibility="gone"
            android:textSize="22sp"
            android:id="@+id/deadline_date_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal|center_vertical"
            android:text="@string/date_not_set" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:visibility="gone"
                android:textSize="22sp"
                android:id="@+id/nextHalaqa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="@string/next_halaqa"
                android:textColor="@android:color/darker_gray" />

            <Button
                android:id="@+id/add_deadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:text="@string/add_deadline_btn"
                android:textColor="@android:color/darker_gray"
                android:textSize="22sp" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:padding="3dp"
        android:layout_marginStart="3dp"
        android:background="@drawable/bg1"
        android:tint="@android:color/holo_red_light"
        android:id="@+id/date_delete"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="0"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="@string/delete_date"
        android:textColor="@android:color/holo_red_light"
        android:textSize="14sp" />

</LinearLayout>

</LinearLayout>