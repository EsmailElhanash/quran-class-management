                    android:contentDescription="@string/done_picking_date"
                    android:padding="5dp"
                    android:visibility="visible"
                    app:srcCompat="@drawable/date_pick_24" />

                <ImageButton
                    android:id="@+id/savePickedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
