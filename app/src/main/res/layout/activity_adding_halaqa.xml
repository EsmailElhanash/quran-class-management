                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/pick_date" />
            </LinearLayout>


        </LinearLayout>

        <!--Wednesday-->
        <LinearLayout
            android:id="@+id/wednesday_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <CheckBox
                android:id="@+id/wednesday_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="dayPicked"
                android:text="@string/wednesday_arabic" />

            <LinearLayout
                android:id="@+id/wednesday_time_write_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/wednesday_time_write_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textDirection="rtl" />

                <Button
                    android:id="@+id/wednesday_time_picker"
                    style="@style/Widget.AppCompat.Button.Colored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/pick_date" />
            </LinearLayout>


        </LinearLayout>

        <!--Thursday-->
        <LinearLayout
            android:id="@+id/thursday_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="vertical"
            tools:ignore="UselessParent">

            <CheckBox
                android:id="@+id/thursday_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="dayPicked"
                android:text="@string/thursday_arabic" />

            <LinearLayout
                android:id="@+id/thursday_time_write_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/thursday_time_write_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
