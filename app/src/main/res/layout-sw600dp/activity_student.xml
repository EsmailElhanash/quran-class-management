<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".secondary_activities.StudentActivity"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent">

    <FrameLayout
        android:layoutDirection="rtl"
        android:layout_height="wrap_content"
        android:layout_width="match_parent">

        <ProgressBar
            android:id="@+id/student_activity_progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                app:titleTextAppearance="@style/Toolbar.TitleText"
                android:id="@+id/student_activity_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/holo_blue_light"
                android:minHeight="?attr/actionBarSize"
                android:theme="@style/toolbar_style"
                app:titleTextColor="@android:color/white" />

            <EditText
                android:textSize="28sp"
                android:padding="5dp"
                android:background="@drawable/bg1"
                android:id="@+id/studentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:autofillHints="@string/studentName"
                android:ems="10"
                android:hint="@string/studentName"
                android:inputType="textPersonName"
                android:singleLine="true" />

            <EditText
                android:textSize="28sp"
                android:padding="5dp"
                android:background="@drawable/bg1"
                android:id="@+id/studentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:autofillHints="@string/studentInfo"
                android:ems="10"
                android:hint="@string/studentInfo"
                android:inputType="textMultiLine" />

            <TextView
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_margin="7dp"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alwagebat_text" />

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/added_hws_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/add_hw_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/green_add_24"
                android:text="@string/add_hw"
                android:textSize="28sp"
                android:textAlignment="viewStart"
                android:textColor="#919191" />

            <Button
                android:textSize="28sp"
                android:id="@+id/saveButton2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/save"
                android:theme="@android:style/Animation" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>